# Copy to .env and adjust (cp .env.example .env). Both `docker compose` and
# `./mvnw spring-boot:run` read it. .env is git-ignored: keep secrets there.

# --- Database (the PostgreSQL of db-postgresql-music) ---
# Host and port as seen from this machine, for local runs. In Docker the API uses
# the container name on the shared network instead (DB_DOCKER_HOST, port 5432).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=music_db
DB_USER=music
DB_PASSWORD=music
# DB_DOCKER_HOST=music-db-postgres
# MUSIC_DB_NETWORK=music-db_default

# --- API ---
# Port the API is reached on from this machine (local run and Docker).
SERVER_PORT=8081
# HMAC key for the access tokens, at least 256 bits: openssl rand -base64 48
# Required in Docker. Empty for local runs: a random key per start (tokens stop working on restart).
APP_JWT_SECRET=
# APP_JWT_ACCESS_TOKEN_TTL=15m
# APP_JWT_REFRESH_TOKEN_TTL=14d
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger UI and /v3/api-docs (true by default)
# APP_API_DOCS_ENABLED=true

# --- Super user (created on first start; the password is only used while the account has none) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
# APP_ADMIN_EMAIL=admin@localhost
# APP_ADMIN_DISPLAY_NAME=Admin
